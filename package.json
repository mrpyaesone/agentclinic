{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "This is testing demo for SDD(spec-driven-development) with AI agentic coding assistant.",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --include src/styles.css src/index.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:seed": "tsx src/db-cli.ts seed",
    "db:migrate:production": "node dist/db-cli.js migrate",
    "db:seed:production": "node dist/db-cli.js seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpyaesone/agentclinic.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mrpyaesone/agentclinic/issues"
  },
  "homepage": "https://github.com/mrpyaesone/agentclinic#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@picocss/pico": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13"
  }
}
