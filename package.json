{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "This is testing demo for SDD(spec-driven-development) with AI agentic coding assistant.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --include src/styles.css src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpyaesone/agentclinic.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mrpyaesone/agentclinic/issues"
  },
  "homepage": "https://github.com/mrpyaesone/agentclinic#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  }
}
